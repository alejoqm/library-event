<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <!-- Spring Boot entry point: default constructor is required -->
    <suppress checks="HideUtilityClassConstructor"
              files="LibraryEventProducerApplication\.java"/>

    <!-- @SpringBootApplication class can be final; Spring uses reflection -->
    <suppress checks="FinalClass"
              files="LibraryEventProducerApplication\.java"/>
</suppressions>